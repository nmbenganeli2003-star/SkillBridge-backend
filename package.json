{
  "name": "skillbridge-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:local": "MONGODB_LOCAL=1 tsx watch src/server.ts",
