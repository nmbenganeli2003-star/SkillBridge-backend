  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.2.3",
    "supertest": "^7.1.4",
    "typescript": "~5.9.3",
    "tsx": "^4.20.6",
    "@types/node": "^24.9.0",
    "@types/express": "^5.0.3",
    "@types/cors": "^2.8.19",
    "@types/cookie-parser": "^1.4.9",
